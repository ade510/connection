# Gmail SMTP Configuration for Wallet Connect
# 1. Use your Gmail address for SMTP_USER
# 2. For SMTP_PASS, generate a 16-character App Password:
#    - Go to https://myaccount.google.com/security
#    - Enable 2-Step Verification if not already enabled
#    - Go to https://myaccount.google.com/apppasswords
#    - Create an App Password for "Mail" / "Wallet Connect"
#    - Copy the 16-character code (without spaces) below

SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
